{
  "name": "nexa-commerce-kh",
  "version": "1.0.0",
  "private": true,
  "description": "Nexa Commerce KH (nexa-commerce-kh) — Multi-Tenant E-Commerce Monorepo Platform",
  "scripts": {
    "dev:api": "cd backend/nckhcoreapi && php artisan serve --port=8003",
    "dev:bot": "cd backend/nckhtelegrambot && python bot_worker.py",
    "dev:storefront": "cd webclient/nckhcustomerstorefront && npm start",
    "dev:admin": "cd webclient/nckhadminportal && npm start",
    "dev:merchant": "cd webclient/nckhmerchantportal && npm start",
    "dev:dashboard": "cd webclient/nckhmerchantportal && npm start",
    "dev:reseller": "cd webclient/nckhresellerportal && npm start",
    "dev:telegram": "cd webclient/nckhtelegramminiapp && npm start",
    "dev:pos": "cd mobile/nckhposapp && flutter run",
    "dev:customerapp": "cd mobile/nckhcustomerapp && flutter run",
    "test:api": "cd backend/nckhcoreapi && php artisan test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "nexa-commerce-kh",
    "laravel",
    "react",
    "flutter",
    "ecommerce",
    "khqr",
    "pos",
    "telegram-mini-app",
    "multitenant"
  ],
  "author": "Nexa Commerce KH",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^7.0.2"
  }
}

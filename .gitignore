# --- Safety net: never commit runtime data, secrets or build artifacts ---

# Environment & Secrets
.env
.env.*
!.env.example
!.env.local.example

# Operating System & IDE
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# PHP / Laravel (backend/nckhcoreapi)
/vendor/
vendor/
backend/nckhcoreapi/vendor/
backend/nckhcoreapi/storage/*.key
backend/nckhcoreapi/storage/framework/cache/*
backend/nckhcoreapi/storage/framework/sessions/*
backend/nckhcoreapi/storage/framework/views/*
.phpunit.result.cache
.phpunit.cache

# Python (backend/nckhtelegrambot)
__pycache__/
*.pyc
venv/
.venv/

# Node / Web builds (webclient/* and packages/*)
node_modules/
/node_modules/
build/
dist/
.npm/

# Flutter / Dart (mobile/*)
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
mobile/**/build/
mobile/**/.dart_tool/
mobile/**/android/.gradle/
mobile/**/ios/Pods/

# Runtime data & uploads
data/
uploads/
backups/
*.db
*.sqlite
*.sqlite3
backend/nckhcoreapi/database/*.sqlite
backend/nckhcoreapi/database/*.sqlite3
backend/nckhcoreapi/public/uploads/
backend/nckhcoreapi/public/backups/

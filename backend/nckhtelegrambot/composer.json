{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ministorekh/nckhtelegrambot",
    "type": "project",
    "description": "Telegram Bot Service for MiniStoreKH / Nexa Commerce KH Platform.",
    "keywords": ["laravel", "telegram", "bot", "ecommerce"],
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
